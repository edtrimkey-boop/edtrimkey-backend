# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Firebase FCM Service Account (Base64 or JSON)
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json

# Google Drive API Service Account
GDRIVE_SERVICE_ACCOUNT=your_gdrive_service_account_json

# Nodemailer / SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ==========================================
# 🚀 TRIM KEY FLOW PAYMENT ORCHESTRATION
# ==========================================
FLOW_API_URL=https://flow.trimkey.in/api/v1
FLOW_API_KEY=tk_live_your_trimkey_flow_api_key_here
# FLOW_MERCHANT_ID is now OPTIONAL (Flow auto-detects your merchant via API key)
